TELEGRAM_BOT_TOKEN=your-bot-token-here
DATABASE_PATH=data/memocore.db
LOG_LEVEL=INFO
# IANA timezone used for user-facing relative times such as "tomorrow 9am".
USER_TIMEZONE=Asia/Ho_Chi_Minh

# Primary model provider: ollama, openai, gemini, deepseek, openrouter, or groq.
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3:4b
# Optional override. Leave blank to use the selected provider's default URL.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_TEMPERATURE=0
# auto uses the best mode the provider supports.
# Options: auto, json, json_schema, prompt_only.
MODEL_STRUCTURED_OUTPUT_MODE=auto

# Optional provider-specific keys. These allow CLI switching without editing this file.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Optional fallback provider used when the primary provider request fails.
# MODEL_FALLBACK_PROVIDER=openrouter
# MODEL_FALLBACK_NAME=meta-llama/llama-3.3-70b-instruct:free
# MODEL_FALLBACK_BASE_URL=
# MODEL_FALLBACK_API_KEY=
# MODEL_FALLBACK_STRUCTURED_OUTPUT_MODE=auto

# Legacy Ollama variables are still accepted during migration.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b
